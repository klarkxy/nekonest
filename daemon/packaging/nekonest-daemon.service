[Unit]
Description=NekoNest host daemon (outbound nest bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Install the binary to ~/.local/bin or adjust ExecStart.
ExecStart=%h/.local/bin/nekonest-daemon
Restart=on-failure
RestartSec=5
# Leave transport mode unset so registration stores the Server's persisted mode
# (new nests default sealed). Set this only as an assertion for a known nest:
# Environment=NEKONEST_TRANSPORT_MODE=sealed
# Environment=NEKONEST_TRANSPORT_MODE=open

# Config defaults to ~/.nekonest/config.json
# WorkingDirectory=%h

[Install]
WantedBy=default.target
