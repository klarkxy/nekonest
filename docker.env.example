# Copy to .env, replace every placeholder, and keep the resulting file private.
NEKONEST_ADMIN_SECRET=replace-with-a-long-random-admin-secret
NEKONEST_BOOTSTRAP_TOKEN=replace-with-a-different-long-random-bootstrap-token
NEKONEST_ALLOWED_ORIGINS=https://nekonest.example.com
NEKONEST_TRUST_PROXY=1
# New data directories default to sealed. Set this only to assert an existing mode.
# NEKONEST_TRANSPORT_MODE=sealed
# NEKONEST_VAPID_PUBLIC_KEY=
# NEKONEST_VAPID_PRIVATE_KEY=
# NEKONEST_VAPID_SUBJECT=mailto:operator@example.com
