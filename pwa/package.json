{
  "name": "nekonest-pwa",
  "private": true,
  "version": "0.2.8-rc.1",
  "packageManager": "pnpm@10.29.2",
  "description": "猫娘乐园 - 从手机续写家里电脑上的线团",
  "license": "SATA-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test --config playwright.config.ts",
    "test:visual:update": "playwright test --config playwright.config.ts --update-snapshots",
    "test:visual:report": "playwright show-report playwright-report",
    "test:visual:live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "naive-ui": "^2.38.2",
    "pinia": "^2.1.7",
    "vue": "^3.4.27",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/dompurify": "^3.2.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "jsdom": "^24.1.0",
    "terser": "^5.31.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.12",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^2.0.0",
    "vue-tsc": "^2.0.19",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "ws": "^8.21.1"
  }
}
