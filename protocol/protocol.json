{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nekonest.local/protocol.json",
  "title": "NekoNest Protocol",
  "description": "JSON envelope for NekoNest phone ↔ server ↔ daemon communication (v1)",
  "$ref": "#/definitions/NekoMessage",
  "definitions": {
    "ProtocolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "major.minor wire version; major mismatch rejects, minor is backward compatible"
    },
    "TransportMode": {
      "type": "string",
      "enum": ["sealed", "open"],
      "description": "Nest transport mode; one mode per nest, no sealed→open downgrade"
    },
    "MessageType": {
      "type": "string",
      "enum": [
        "device_online",
        "device_offline",
        "device_list",
        "session_list",
        "session_update",
        "session_message",
        "send_prompt",
        "prompt_status_query",
        "prompt_not_seen",
        "prompt_accepted",
        "prompt_committed",
        "prompt_failed",
        "prompt_sent",
        "approve",
        "deny",
        "interrupt",
        "steer",
        "start_thread",
        "thread_starting",
        "thread_owned",
        "thread_failed",
        "thread_indeterminate",
        "heartbeat",
        "error",
        "register_device",
        "auth_response",
        "pair_request",
        "pair_confirm",
        "pair_ready",
        "pair_failed",
        "key_package",
        "phone_revoked",
        "attention_event",
        "subscribe",
        "subscribe_ack",
        "fetch_history",
        "session_history"
      ]
    },
    "SealedPayload": {
      "type": "object",
      "required": [
        "alg",
        "key_scope",
        "epoch",
        "sender_id",
        "recipient_id",
        "sequence",
        "nonce",
        "ciphertext"
      ],
      "additionalProperties": false,
      "properties": {
        "alg": {
          "type": "string",
          "description": "AEAD algorithm identifier (e.g. aes-256-gcm)"
        },
        "version": {
          "type": "integer",
          "description": "Sealed payload format version"
        },
        "key_scope": {
          "type": "string",
          "enum": ["device_catalog", "session"]
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "sender_id": { "type": "string" },
        "recipient_id": { "type": "string" },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "nonce": {
          "type": "string",
          "description": "Base64url-encoded 96-bit nonce"
        },
        "ciphertext": {
          "type": "string",
          "description": "Base64url-encoded ciphertext"
        }
      }
    },
    "NekoMessage": {
      "type": "object",
      "required": ["type", "device_id", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "protocol_version": { "$ref": "#/definitions/ProtocolVersion" },
        "transport_mode": { "$ref": "#/definitions/TransportMode" },
        "type": { "$ref": "#/definitions/MessageType" },
        "device_id": {
          "type": "string",
          "description": "Unique device identifier"
        },
        "session_id": {
          "type": "string",
          "description": "Agent session identifier (optional for device-level messages)"
        },
        "client_msg_id": {
          "type": "string",
          "description": "Client idempotency id (relay-visible for prompt/start)"
        },
        "timestamp": {
          "type": "integer",
          "description": "Unix timestamp in seconds"
        },
        "payload": {
          "type": "object",
          "description": "Open-mode or plaintext control payload; must be absent when sealed_payload is set"
        },
        "sealed_payload": {
          "$ref": "#/definitions/SealedPayload",
          "description": "Sealed application payload; must be absent in open mode"
        }
      }
    },
    "Device": {
      "type": "object",
      "required": ["id", "name", "os", "status"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "os": { "type": "string", "enum": ["windows", "linux"] },
        "status": { "type": "string", "enum": ["online", "offline"] },
        "last_seen": { "type": "integer" },
        "active_agents": { "type": "integer" },
        "daemon_version": {
          "type": "string",
          "description": "NekoNest application release reported by the live daemon; absent when offline or unreported"
        }
      }
    },
    "AgentType": {
      "type": "string",
      "enum": ["claude_code", "codex", "kilo", "kimi_cli", "grok_build"]
    },
    "SessionCapabilities": {
      "type": "object",
      "description": "Absent fields default to false/unsupported",
      "additionalProperties": false,
      "properties": {
        "control_mode": {
          "type": "string",
          "enum": ["app_server", "exec_resume", "compatibility"]
        },
        "approve": { "type": "boolean" },
        "deny": { "type": "boolean" },
        "interrupt": { "type": "boolean" },
        "steer": { "type": "boolean" },
        "queue": { "type": "boolean" },
        "spawn": { "type": "boolean" },
        "attachment_mode": {
          "type": "string",
          "enum": [
            "native_image_and_file",
            "native_image",
            "path_best_effort",
            "unsupported"
          ]
        }
      }
    },
    "AgentStartCapability": {
      "type": "object",
      "description": "Device-level native thread-start capability published in session_list. Unknown or unavailable entries mean the phone must not offer creation. During minor-version migration only, an omitted catalog may fall back to an explicit per-session Codex spawn flag.",
      "required": ["agent_type", "available", "spawn"],
      "additionalProperties": false,
      "properties": {
        "agent_type": { "$ref": "#/definitions/AgentType" },
        "available": {
          "type": "boolean",
          "description": "The daemon found a usable native start path for this agent."
        },
        "spawn": {
          "type": "boolean",
          "description": "Native thread creation is currently permitted for this agent."
        },
        "reason": {
          "type": "string",
          "description": "Concrete unavailable or disabled reason for UI display."
        },
        "control_path": { "type": "string", "description": "Native mechanism, for example app_server, cli, or acp." },
        "control_version": { "type": "string", "description": "Optional probed native control protocol or CLI version." }
      }
    },
    "SessionListPayload": {
      "type": "object",
      "description": "Payload of session_list. Older peers may omit start_capabilities.",
      "properties": {
        "sessions": {
          "type": "array",
          "items": { "$ref": "#/definitions/AgentSession" }
        },
        "start_capabilities": {
          "type": "array",
          "description": "Optional device-level catalog for native thread creation. Absent or unknown agents are unavailable; this catalog gates phone-local drafts and start_thread.",
          "items": { "$ref": "#/definitions/AgentStartCapability" }
        }
      }
    },
    "AgentSession": {
      "type": "object",
      "required": ["id", "device_id", "agent_type", "status"],
      "properties": {
        "id": { "type": "string" },
        "device_id": { "type": "string" },
        "agent_type": { "$ref": "#/definitions/AgentType" },
        "status": {
          "type": "string",
          "enum": ["idle", "running", "waiting_user", "waiting_approval", "error"]
        },
        "summary": { "type": "string" },
        "last_activity": { "type": "integer" },
        "project_dir": { "type": "string" },
        "project": { "type": "string" },
        "capabilities": { "$ref": "#/definitions/SessionCapabilities" },
        "pending_approval": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "tool_name": { "type": "string" },
            "description": { "type": "string" },
            "parameters": { "type": "object" }
          }
        }
      }
    },
    "SessionMessage": {
      "type": "object",
      "required": ["id", "role", "content", "timestamp"],
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "enum": ["assistant", "user", "tool", "system"] },
        "content": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["thinking", "text", "assistant", "tool_call", "tool_result", "error", "system"]
        },
        "timestamp": { "type": "integer" },
        "metadata": { "type": "object" }
      }
    },
    "AttachmentRef": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "name": { "type": "string" },
        "mime": { "type": "string" },
        "size": { "type": "integer" },
        "key": { "type": "string" }
      }
    },
    "StartThreadPayload": {
      "type": "object",
      "description": "Phone-local draft creation request. The daemon creates the native thread and delivers prompt as its first prompt; the phone must not create a session row itself. Legacy cwd and initial_prompt aliases may be accepted by a receiver.",
      "required": ["agent_type", "operation_id", "project_dir", "prompt"],
      "properties": {
        "agent_type": { "$ref": "#/definitions/AgentType" },
        "project_dir": {
          "type": "string",
          "description": "Must exactly resolve to a directory in the daemon's current discovered project-dir union; arbitrary path input is rejected."
        },
        "cwd": {
          "type": "string",
          "description": "Legacy project_dir alias; when both are supplied they must resolve to the same discovered directory."
        },
        "operation_id": { "type": "string", "description": "Stable start operation id; normally equals envelope client_msg_id." },
        "prompt": {
          "type": "string",
          "description": "Required first prompt copied from the phone-local draft."
        },
        "initial_prompt": {
          "type": "string",
          "description": "Legacy prompt alias accepted by a receiver when prompt is absent."
        }
      }
    },
    "ThreadStartResult": {
      "type": "object",
      "description": "Payload for thread_starting, thread_owned, thread_failed, and thread_indeterminate. thread_owned is legal only after both positive first-prompt acknowledgement and ownership in the selected agent's native store; otherwise the sender must fail closed as thread_indeterminate.",
      "required": ["operation_id", "state"],
      "properties": {
        "agent_type": { "$ref": "#/definitions/AgentType" },
        "operation_id": { "type": "string", "description": "Stable start operation id; normally equals envelope client_msg_id." },
        "state": {
          "type": "string",
          "enum": ["thread_starting", "thread_owned", "thread_failed", "thread_indeterminate"]
        },
        "session": {
          "$ref": "#/definitions/AgentSession",
          "description": "Required by the sender for thread_owned; it is a native-store-owned session."
        },
        "session_id": { "type": "string", "description": "Native wire session id when known." },
        "thread_id": { "type": "string", "description": "Native CLI thread id when distinct from session_id." },
        "prompt_accepted": { "type": "boolean", "description": "True only when the native control path positively confirmed the first prompt. thread_owned requires true; false or absent requires thread_indeterminate and the phone must retain the prompt." },
        "reason": { "type": "string", "description": "Failure or indeterminate explanation safe for display." },
        "error": { "type": "string", "description": "Compatibility error text." },
        "message": { "type": "string", "description": "Compatibility display message." }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "thread_owned" } },
            "required": ["state"]
          },
          "then": {
            "required": ["session_id", "prompt_accepted"],
            "properties": {
              "session_id": { "type": "string", "minLength": 1 },
              "prompt_accepted": { "const": true }
            }
          }
        }
      ]
    }
  }
}
