{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nekonest.local/protocol.json",
  "title": "NekoNest Protocol",
  "description": "JSON envelope for NekoNest phone ↔ server ↔ daemon communication",
  "$ref": "#/definitions/NekoMessage",
  "definitions": {
    "MessageType": {
      "type": "string",
      "enum": [
        "device_online",
        "device_offline",
        "device_list",
        "session_list",
        "session_update",
        "session_message",
        "send_prompt",
        "prompt_status_query",
        "prompt_not_seen",
        "prompt_accepted",
        "prompt_committed",
        "prompt_failed",
        "prompt_sent",
        "approve",
        "deny",
        "interrupt",
        "heartbeat",
        "error",
        "register_device",
        "auth_response",
        "pair_request",
        "pair_confirm",
        "subscribe",
        "subscribe_ack",
        "fetch_history",
        "session_history"
      ]
    },
    "NekoMessage": {
      "type": "object",
      "required": ["type", "device_id", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/definitions/MessageType" },
        "device_id": {
          "type": "string",
          "description": "Unique device identifier"
        },
        "session_id": {
          "type": "string",
          "description": "Agent session identifier (optional for device-level messages)"
        },
        "timestamp": {
          "type": "integer",
          "description": "Unix timestamp in seconds"
        },
        "payload": {
          "type": "object",
          "description": "Message-specific payload"
        }
      }
    },
    "Device": {
      "type": "object",
      "required": ["id", "name", "os", "status"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "os": { "type": "string", "enum": ["windows"] },
        "status": { "type": "string", "enum": ["online", "offline"] },
        "last_seen": { "type": "integer" },
        "active_agents": { "type": "integer" }
      }
    },
    "AgentSession": {
      "type": "object",
      "required": ["id", "device_id", "agent_type", "status"],
      "properties": {
        "id": { "type": "string" },
        "device_id": { "type": "string" },
        "agent_type": {
          "type": "string",
          "enum": ["claude_code", "codex", "kilo", "kimi_cli", "grok_build"]
        },
        "status": { "type": "string", "enum": ["running", "idle", "waiting_approval"] },
        "summary": { "type": "string" },
        "last_activity": { "type": "integer" },
        "project_dir": { "type": "string" },
        "project": { "type": "string" },
        "pending_approval": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "tool_name": { "type": "string" },
            "description": { "type": "string" },
            "parameters": { "type": "object" }
          }
        }
      }
    },
    "SessionMessage": {
      "type": "object",
      "required": ["id", "role", "content", "timestamp"],
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "enum": ["assistant", "user", "tool", "system"] },
        "content": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["thinking", "text", "assistant", "tool_call", "tool_result", "error", "system"]
        },
        "timestamp": { "type": "integer" },
        "metadata": { "type": "object" }
      }
    },
    "AttachmentRef": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "name": { "type": "string" },
        "mime": { "type": "string" },
        "size": { "type": "integer" },
        "key": { "type": "string" }
      }
    }
  }
}
